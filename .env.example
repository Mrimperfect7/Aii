# AI Try-On provider abstraction — swapping vendors is an env change only.
# "mock" works out of the box with no credentials, for building/demoing the UI.
TRYON_PROVIDER=mock
# TRYON_PROVIDER=perfectcorp

# Only required when TRYON_PROVIDER is a real vendor:
TRYON_API_URL=https://yce-api-01.makeupar.com
TRYON_API_KEY=
TRYON_MODEL=
# Async task creation + polling needs real headroom — 20s is often too
# tight. 45-60s is safer; the UI already shows a "Creating your virtual
# try-on..." state the whole time.
TRYON_TIMEOUT_MS=45000

# Used server-side to resolve static character asset paths to absolute URLs.
NEXT_PUBLIC_SITE_URL=https://shyn.ish
